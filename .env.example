# Flask secret key (auto-generated if not set)
FLASK_SECRET=

# DeepSeek API Key (required for A2A dialogue)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zhihu OAuth (for user login, followers/followed features)
ZHIHU_OAUTH_APP_ID=your_app_id
ZHIHU_OAUTH_APP_KEY=your_oauth_app_key
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8050/callback

# Zhihu Community API (for ring data collection, posting, commenting)
ZHIHU_COMMUNITY_APP_KEY=your_community_app_key
ZHIHU_COMMUNITY_APP_SECRET=your_community_app_secret
